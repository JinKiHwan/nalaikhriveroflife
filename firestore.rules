rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approved() {
      return profileExists() && (profile().status == 'approved' || !('status' in profile()));
    }

    function master() {
      return approved() && profile().role == 'master';
    }

    function viceMaster() {
      return approved() && profile().role == 'vice_master';
    }

    function operator() {
      return master() || viceMaster();
    }

    function teacher() {
      return approved() && (profile().role == 'teacher' || profile().role == 'vice_master' || profile().role == 'master');
    }

    function delegatedRole(role) {
      return role == 'vice_master' || role == 'teacher' || role == 'normal';
    }

    function viceMasterVisibilityUpdate() {
      return viceMaster()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isHidden',
          'hiddenAt',
          'hiddenBy'
        ]);
    }

    function authorContentUpdate() {
      return approved()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isHidden == resource.data.isHidden;
    }

    function ownImage() {
      return approved() && resource.data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId is string
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'normal'
        && request.resource.data.status == 'pending';

      allow get: if (signedIn() && request.auth.uid == userId) || operator();
      allow list: if operator();
      allow update: if (
        master()
        && !(request.auth.uid == userId && request.resource.data.status == 'expelled')
        && (
          (
            resource.data.role == 'master'
            && request.auth.uid == userId
            && request.resource.data.role == 'master'
          )
          || (
            resource.data.role != 'master'
            && delegatedRole(request.resource.data.role)
          )
        )
      ) || (
        viceMaster()
        && (resource.data.role == 'normal' || resource.data.role == 'teacher')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'approvedAt',
          'approvedBy',
          'rejectedAt',
          'rejectedBy',
          'expelledAt',
          'expelledBy'
        ])
        && (
          (
            resource.data.status == 'pending'
            && (
              request.resource.data.status == 'approved'
              || request.resource.data.status == 'rejected'
            )
          )
          || (
            (resource.data.status == 'approved' || !('status' in resource.data))
            && request.resource.data.status == 'expelled'
          )
        )
      );
      allow delete: if false;
    }

    match /sermons/{sermonId} {
      allow read: if approved();
      allow create: if master();
      allow update: if master() || authorContentUpdate() || viceMasterVisibilityUpdate();
      allow delete: if operator();
    }

    match /notices/{noticeId} {
      allow read: if approved();
      allow create: if master();
      allow update: if master() || authorContentUpdate() || viceMasterVisibilityUpdate();
      allow delete: if operator();
    }

    match /church_news/{postId} {
      allow read: if approved();
      allow create: if master();
      allow update: if master() || authorContentUpdate() || viceMasterVisibilityUpdate();
      allow delete: if operator();
    }

    match /church_events/{postId} {
      allow read: if approved();
      allow create: if master();
      allow update: if master() || authorContentUpdate() || viceMasterVisibilityUpdate();
      allow delete: if operator();
    }

    match /content_images/{imageId} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.createdBy == request.auth.uid;
      allow update: if master() || (
        ownImage()
        && request.resource.data.createdBy == resource.data.createdBy
      );
      allow delete: if operator() || ownImage();
    }

    match /settings/{settingId} {
      allow read: if approved();
      allow create, update: if operator()
        && (
          (
            settingId == 'sermon_categories'
            && request.resource.data.items is list
          )
          || (
            settingId == 'home_hero'
            && request.resource.data.verseKo is string
            && request.resource.data.verseMn is string
            && request.resource.data.referenceKo is string
            && request.resource.data.referenceMn is string
            && request.resource.data.imageId is string
          )
        );
      allow delete: if master()
        && (settingId == 'sermon_categories' || settingId == 'home_hero');
    }

    match /teachers_posts/{postId} {
      allow read, write: if teacher();
    }

    match /qt/{qtDate} {
      allow read: if approved();
      allow write: if master();

      match /comments/{commentId} {
        allow read: if approved();
        allow create: if approved() && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if master() || (approved() && resource.data.createdBy == request.auth.uid);
      }
    }
  }
}
